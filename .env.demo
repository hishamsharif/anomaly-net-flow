# Demo configuration — copy to .env (setup.sh does this automatically).
# All variables have sensible defaults for local development.

# ─── Dataset auto-download (Google Drive) ─────────────────────────────────────
# CIC-IDS2017 CSVs are hosted on Google Drive (225 MB zip).
# setup.sh downloads and extracts them automatically if data/CIC-IDS2017/ is empty.
CICIDS2017_GDRIVE_FILE_ID=10UG7eEAUI8kV4_CMFsrK-5nVz4Bm0Ey3

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite — file-based, no server needed. Created automatically on first run.
DATABASE_URL=sqlite+aiosqlite:///./anomaly_net_flow.db

# ─── Paths ────────────────────────────────────────────────────────────────────
# Folder containing the CIC-IDS2017 CSV files (loaded at first train)
BUNDLED_DATASET_DIR=data/CIC-IDS2017

# Where trained model artefacts are persisted
MODEL_ARTEFACT_DIR=models

# ─── Training thresholds ──────────────────────────────────────────────────────
# Minimum analyst verdicts since last training to unlock the Fine-tune button
FINE_TUNE_K_THRESHOLD=50

# Fraction of pre-savepoint rows used as replay buffer during AE fine-tuning
AE_REPLAY_BUFFER_FRACTION=0.1

# Percentile of benign validation MSE used to set the AE anomaly threshold
AE_ANOMALY_THRESHOLD_PERCENTILE=95.0

# Number of epochs to freeze the AE encoder at the start of fine-tuning
AE_FREEZE_EPOCHS=5

# ─── Feature engineering ──────────────────────────────────────────────────────
# Step 1 — drop features with variance below this (0 = drop constants only)
#   Try 0.01 → 0.05 → 0.10; stop before F1 drops
VARIANCE_THRESHOLD=0.0

# Step 2 — drop one from each correlated pair with |Pearson r| above this
CORRELATION_THRESHOLD=0.95

# Step 3 — keep only top-K features ranked by mutual information with the label
#   0 = keep all features that survived steps 1 & 2
#   Suggested starting point for CIC-IDS2017: try 40, 30, 20 and monitor F1
FEATURE_SELECTION_K=0

# Step 4 — scaler applied after feature selection
#   robust    (default)  — median/IQR, best for outlier-heavy network flow data
#   standard             — mean/std, assumes Gaussian; sensitive to outliers
#   quantile             — maps to normal distribution; most aggressive outlier removal
#   maxabs               — scale to [-1,1], preserves sparsity
#   none                 — skip scaling (tree models don't need it; AE usually does)
SCALER_TYPE=robust

# ─── API ──────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# Comma-separated CORS origins (Vite dev server is whitelisted by default)
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000
